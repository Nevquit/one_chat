# 复制为 .env 后填入真实值，不要提交到仓库

LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-请填写
LLM_MODEL=deepseek-chat

EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-请填写
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

CHROMA_PATH=data/chroma
CHROMA_COLLECTION=wanchain_docs
INDEX_MANIFEST_PATH=data/processed/index_manifest.json

BRIDGE_API_BASE=https://bridge-api.wanchain.org
MIN_RELEVANCE=0.5

CHECKPOINTER=redis
CHECKPOINT_URL=redis://redis:6379/0
CHECKPOINT_TTL_MINUTES=1440
